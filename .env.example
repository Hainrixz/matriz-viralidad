# Copia este archivo como .env  (cp .env.example .env)  y pega tus llaves despues del "=",
# sin comillas ni espacios. El .env es PRIVADO: nunca lo subas ni se lo pases a nadie.
# Claude no lo lee: los scripts lo leen por dentro.

# Token de Apify — OBLIGATORIO. Sin el no hay de donde bajar datos.
# Gratis en https://apify.com/sign-up (sin tarjeta, ~5 USD de credito al mes).
# Despues: Settings -> API & Integrations -> copia el "Personal API token".
APIFY_TOKEN=pega_aqui_tu_token

# Llave de Gemini — OPCIONAL. Con ella los videos se analizan oyendo el audio.
# Sin ella el sistema usa la skill "watch" (si la tienes) o los fotogramas, gratis.
# Gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Que camino usa el analisis de video. OPCIONAL, por defecto "auto".
#   auto    Gemini (oye el audio). Si no esta disponible, cae a fotogramas y te avisa.
#   gemini  Siempre Gemini. Si falla, falla: no hay caida silenciosa.
#   local   Siempre fotogramas. Gemini no se llama nunca.
MATRIZ_ANALIZADOR=auto
